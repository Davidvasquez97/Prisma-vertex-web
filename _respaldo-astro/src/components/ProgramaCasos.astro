---
import { wa, MENSAJES } from '../config';
---

<section class="seccion">
  <div class="lienzo">
    <div class="max-w-[680px]">
      <h2 class="text-d2">Programa de casos documentados</h2>
      <p class="mt-6 text-cuerpo-lg text-gris">
        Estamos documentando resultados en sectores donde todavía no tenemos
        caso publicado. Si su empresa encaja, hacemos el diagnóstico completo
        sin costo a cambio de poder publicar el caso.
      </p>
      <a
        href={wa(MENSAJES.casos)}
        target="_blank"
        rel="noopener"
        class="boton boton-linea mt-8"
      >
        Postular mi empresa
      </a>
    </div>
  </div>
</section>
