---
import Logo from './Logo.astro';
import { CONTACTO, SITE } from '../config';

const anio = new Date().getFullYear();
---

<footer class="filete">
  <div class="lienzo grid gap-10 py-14 md:grid-cols-[1fr_auto] md:items-start md:gap-16">
    <div>
      <span class="text-tinta"><Logo /></span>
      <p class="mt-4 text-menudo text-gris">
        {CONTACTO.ciudad}, {CONTACTO.departamento}, {CONTACTO.pais}
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 md:gap-16">
      <div>
        <p class="text-menudo font-semibold">Contacto</p>
        <ul class="mt-3 space-y-2 text-menudo text-gris">
          <li>
            <a href={`mailto:${CONTACTO.correo}`} class="hover:text-azul">{CONTACTO.correo}</a>
          </li>
          <li>
            <a href={`https://wa.me/${CONTACTO.whatsapp}`} target="_blank" rel="noopener" class="hover:text-azul">
              WhatsApp {CONTACTO.whatsappVisible}
            </a>
          </li>
          <li>
            <a href={CONTACTO.instagram} target="_blank" rel="noopener" class="hover:text-azul">
              Instagram {CONTACTO.instagramVisible}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-menudo font-semibold">Legal</p>
        <ul class="mt-3 space-y-2 text-menudo text-gris">
          <li><a href="/terminos" class="hover:text-azul">Términos y condiciones</a></li>
          <li><a href="/privacidad" class="hover:text-azul">Política de privacidad</a></li>
          <li><a href="/terminos#aviso" class="hover:text-azul">Aviso legal</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="filete">
    <div class="lienzo py-6">
      <p class="text-menudo text-gris">
        &copy; {anio} {SITE.nombre}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
